{
  "manifest_version": 3,
  "name": "MyLoad — Download Manager Integration",
  "version": "1.0.0",
  "description": "Automatically send browser downloads and magnet links to MyLoad.",
  "homepage_url": "https://github.com/arshiatxd/MLDM-MyLoadDownloadManager",
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MyLoad Integration",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
